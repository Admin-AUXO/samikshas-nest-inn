---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { homeImg } from '../lib/images';
import { menu, combo, extras, menuNotes } from '../data/menu';
import { waLink } from '../data/site';

const order = waLink("Hi, we're staying at Samiksha's Nest Inn and would like to place a food order.");
---
<Base title="Dining" description="The full menu at Samiksha's Nest Inn, Kotagiri: South Indian tiffin, biriyani, meals, gravies and barbecue, cooked to order by the caretaker, with prices.">
  <section class="page-hero">
    <div class="page-hero__img">
      <Image src={homeImg('bonfire-tents')} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    </div>
    <div class="wrap page-hero__body">
      <p class="eyebrow">Dining</p>
      <h1>Home-style food, cooked to order</h1>
      <p>Our caretaker Pradeep cooks every meal fresh for your group. Order at least four hours ahead.</p>
    </div>
  </section>

  <nav class="tabs" aria-label="Menu sections">
    <div class="wrap tabs__inner">
      {menu.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
      <a href="#extras">Extras</a>
    </div>
  </nav>

  <section class="section section--mist">
    <div class="wrap">
      <div class="menu">
        {menu.map((course) => (
          <section class="course" id={course.id} aria-labelledby={`${course.id}-title`}>
            <header class="course__head">
              <h2 id={`${course.id}-title`}>{course.title}</h2>
              {course.note && <p>{course.note}</p>}
            </header>
            <ul class="dishes">
              {course.dishes.map((d) => (
                <li class="dish">
                  <span class:list={['mark', d.veg ? 'mark--veg' : 'mark--non']} role="img" aria-label={d.veg ? 'Vegetarian' : 'Non-vegetarian'}></span>
                  <span class="dish__body">
                    <span class="dish__name">{d.name}{d.favourite && <Icon name="star" class="star" />}</span>
                    {d.detail && <span class="dish__detail">{d.detail}</span>}
                  </span>
                  <span class="dish__price">{d.price}</span>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="legend">
        <span><span class="mark mark--veg"></span> Vegetarian</span>
        <span><span class="mark mark--non"></span> Non-vegetarian</span>
        <span><Icon name="star" class="star" /> Named in guest reviews</span>
      </p>
    </div>
  </section>

  <section class="section section--dark" id="combo">
    <div class="wrap feature">
      <div class="frame feature__img">
        <Image src={homeImg('grill')} alt="Chicken on the barbecue grill" widths={[500, 900, 1300]} sizes="(min-width: 900px) 45vw, 100vw" />
      </div>
      <div class="feature__copy">
        <p class="eyebrow">For the table</p>
        <h2 class="title">{combo.title} <span class="feature__price">{combo.price}</span></h2>
        <ul class="feature__list">
          {combo.items.map((i) => <li>{i}</li>)}
        </ul>
        <blockquote>
          <p>He personally prepared a delicious dinner with nearly 10 dishes, all of which were exceptional in taste. The BBQ chicken is a must-try!</p>
          <cite>Kumar, March 2025</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section" id="extras">
    <div class="wrap two">
      <div>
        <p class="eyebrow">Extras</p>
        <h2 class="title">Bonfires, treks and celebrations</h2>
        <ul class="extras">
          {extras.map((e) => (
            <li>
              <span><strong>{e.name}</strong><span class="extras__detail">{e.detail}</span></span>
              <span class="extras__price">{e.price}</span>
            </li>
          ))}
        </ul>
      </div>
      <div id="notes">
        <p class="eyebrow">How ordering works</p>
        <h2 class="title">Good to know</h2>
        <ul class="notes">
          {menuNotes.map((n) => <li>{n}</li>)}
        </ul>
        <a class="btn btn--primary" href={order} target="_blank" rel="noopener"><Icon name="whatsapp" /> Order on WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tabs {
    position: sticky;
    top: calc(4.5rem + env(safe-area-inset-top, 0px));
    z-index: 5;
    background: rgba(251, 249, 244, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .tabs__inner {
    display: flex;
    gap: 1.75rem;
    overflow-x: auto;
    padding-block: 1rem;
    scrollbar-width: none;
  }

  .tabs__inner::-webkit-scrollbar {
    display: none;
  }

  .tabs a {
    flex: none;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--muted);
  }

  .tabs a:hover {
    color: var(--ink);
  }

  .menu {
    background: var(--paper);
    padding: clamp(1.75rem, 5vw, 4.5rem);
    display: grid;
    gap: clamp(3rem, 5vw, 4rem) 5rem;
  }

  @media (min-width: 900px) {
    .menu {
      grid-template-columns: 1fr 1fr;
    }
  }

  .course {
    scroll-margin-top: 9rem;
    align-self: start;
  }

  .course__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px solid var(--ink);
  }

  .course__head h2 {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
  }

  .course__head p {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .dishes {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dish {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.85rem;
    align-items: baseline;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .mark {
    display: inline-block;
    position: relative;
    width: 0.75rem;
    height: 0.75rem;
    border: 1.5px solid;
    border-radius: 2px;
    transform: translateY(0.05rem);
  }

  .mark::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 50%;
  }

  .mark--veg {
    border-color: #2f8a3e;
  }

  .mark--veg::after {
    background: #2f8a3e;
  }

  .mark--non {
    border-color: #9b3a2a;
  }

  .mark--non::after {
    background: #9b3a2a;
  }

  .dish__body {
    display: grid;
  }

  .dish__name {
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.35;
  }

  .dish__detail {
    font-size: 0.825rem;
    color: var(--muted);
  }

  .dish__price {
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  :global(.star) {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-left: 0.4rem;
    color: var(--brass);
    vertical-align: 0.05em;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend :global(.star) {
    margin-left: 0;
  }

  .feature {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .feature {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  .feature__img {
    aspect-ratio: 4 / 3;
  }

  .feature__copy {
    display: grid;
    gap: 1.25rem;
  }

  .feature__price {
    font-family: var(--sans);
    font-size: 0.5em;
    color: var(--brass-soft);
    vertical-align: middle;
    margin-left: 0.5rem;
  }

  .feature__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0;
    color: rgba(251, 249, 244, 0.85);
  }

  .feature__list li:not(:last-child)::after {
    content: '·';
    margin-inline: 0.7rem;
    color: var(--brass-soft);
  }

  .feature blockquote {
    margin: 0.75rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-light);
  }

  .feature blockquote p {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .feature cite {
    display: block;
    margin-top: 0.5rem;
    font-style: normal;
    font-size: 0.85rem;
    color: rgba(251, 249, 244, 0.6);
  }

  .two {
    display: grid;
    gap: 4rem;
  }

  @media (min-width: 900px) {
    .two {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  .two .eyebrow {
    margin-bottom: 1rem;
  }

  .two .title {
    margin-bottom: 1.75rem;
  }

  #notes {
    scroll-margin-top: 9rem;
  }

  .extras,
  .notes {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .extras li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .extras strong {
    display: block;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.15rem;
  }

  .extras__detail {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .extras__price {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .notes li {
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
</style>
