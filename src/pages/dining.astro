---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { homeImg } from '../lib/images';
import { menu, feast, menuNotes } from '../data/menu';
import { waLink } from '../data/site';

const order = waLink("Hi, we're staying at Samiksha's Nest Inn. Could you share the menu card and prices?");
---
<Base title="Dining" description="Breakfast, lunch, dinner and barbecue at Samiksha's Nest Inn, Kotagiri. Home-style South Indian food cooked to order by our caretaker.">
  <section class="page-hero">
    <div class="page-hero__img">
      <Image src={homeImg('bonfire')} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" />
    </div>
    <div class="wrap page-hero__body">
      <p class="eyebrow">Dining</p>
      <h1>Home-style food, cooked to order</h1>
      <p>Our caretaker Pradeep cooks every meal fresh for your group. Order lunch and dinner at least four hours ahead.</p>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <nav class="menu-tabs" aria-label="Menu sections">
        {menu.map((c) => <a href={`#${c.id}`}>{c.title}</a>)}
      </nav>
      <div class="menu-card">
        {menu.map((course) => (
          <section class="course" id={course.id} aria-labelledby={`${course.id}-title`}>
            <header class="course__head">
              <p class="eyebrow">{course.kicker}</p>
              <h2 id={`${course.id}-title`} class="title">{course.title}</h2>
              <p class="course__intro">{course.intro}</p>
            </header>
            <ul class="dishes">
              {course.dishes.map((d) => (
                <li class="dish">
                  <span class:list={['dish__mark', d.veg ? 'dish__mark--veg' : 'dish__mark--non']} aria-label={d.veg ? 'Vegetarian' : 'Non-vegetarian'} role="img"></span>
                  <div>
                    <p class="dish__name">{d.name}{d.favourite && <Icon name="star" class="dish__star" />}</p>
                    {d.text && <p class="dish__text">{d.text}</p>}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="legend">
        <span><span class="dish__mark dish__mark--veg"></span> Vegetarian</span>
        <span><span class="dish__mark dish__mark--non"></span> Non-vegetarian</span>
        <span><Icon name="star" class="dish__star" /> Mentioned in guest reviews</span>
      </p>
    </div>
  </section>

  <section class="section section--dark" id="feast">
    <div class="wrap feast">
      <div class="frame feast__img">
        <Image src={homeImg('bonfire-evening')} alt="Guests around the bonfire on the lawn" widths={[500, 900, 1200]} sizes="(min-width: 900px) 45vw, 100vw" />
      </div>
      <div class="feast__copy">
        <p class="eyebrow">For groups</p>
        <h2 class="title">{feast.title}</h2>
        <p class="lede">{feast.text}</p>
        <blockquote>
          <p>{feast.quote}</p>
          <cite>{feast.by}</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section" id="notes">
    <div class="wrap notes">
      <div>
        <p class="eyebrow">How ordering works</p>
        <h2 class="title">Good to know</h2>
      </div>
      <div>
        <ul class="notes__list">
          {menuNotes.map((n) => <li>{n}</li>)}
        </ul>
        <a class="btn btn--primary" href={order} target="_blank" rel="noopener"><Icon name="whatsapp" /> Ask for the menu and prices</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .menu-tabs {
    position: sticky;
    top: calc(4.5rem + env(safe-area-inset-top, 0px));
    z-index: 5;
    display: flex;
    gap: 1.75rem;
    overflow-x: auto;
    padding-block: 1rem;
    margin-bottom: 2rem;
    background: var(--mist);
    border-bottom: 1px solid var(--line);
  }

  .menu-tabs a {
    flex: none;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--muted);
  }

  .menu-tabs a:hover {
    color: var(--ink);
  }

  .menu-card {
    background: var(--paper);
    padding: clamp(1.5rem, 5vw, 4.5rem);
    display: grid;
    gap: clamp(3rem, 6vw, 4.5rem);
  }

  .course {
    display: grid;
    gap: 1.75rem;
    scroll-margin-top: 9rem;
  }

  @media (min-width: 900px) {
    .course {
      grid-template-columns: 1fr 2fr;
      gap: 4rem;
    }
  }

  .course + .course {
    padding-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 1px solid var(--line);
  }

  .course__head {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .course__intro {
    color: var(--muted);
    max-width: 22rem;
  }

  .dishes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  @media (min-width: 700px) {
    .dishes {
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
    }
  }

  .dish {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .dish__mark {
    display: inline-block;
    position: relative;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.4rem;
    border: 1.5px solid;
    border-radius: 2px;
  }

  .dish__mark::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 50%;
  }

  .dish__mark--veg {
    border-color: #2f8a3e;
  }

  .dish__mark--veg::after {
    background: #2f8a3e;
  }

  .dish__mark--non {
    border-color: #9b3a2a;
  }

  .dish__mark--non::after {
    background: #9b3a2a;
  }

  .dish__name {
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.35;
  }

  :global(.dish__star) {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    margin-left: 0.4rem;
    color: var(--brass);
    vertical-align: 0.05em;
  }

  .dish__text {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0.15rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend .dish__mark {
    margin-top: 0;
  }

  .legend :global(.dish__star) {
    margin-left: 0;
  }

  .feast {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .feast {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  .feast__img {
    aspect-ratio: 4 / 5;
  }

  .feast__copy {
    display: grid;
    gap: 1.25rem;
  }

  .feast blockquote {
    margin: 0.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-light);
  }

  .feast blockquote p {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .feast cite {
    display: block;
    margin-top: 0.5rem;
    font-style: normal;
    font-size: 0.85rem;
    color: rgba(250, 247, 241, 0.6);
  }

  .notes {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .notes {
      grid-template-columns: 1fr 1.6fr;
      gap: 6rem;
    }
  }

  .notes .eyebrow {
    margin-bottom: 1rem;
  }

  .notes__list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .notes__list li {
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .notes__list li:first-child {
    border-top: 1px solid var(--line);
  }
</style>
